# =============================================================================
# .env — variáveis de ambiente para o CRM com WhatsApp via WAHA
# Copie para .env.local (Next.js) e preencha.
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js / App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# Service role key — NUNCA expor ao client. Só backend (API routes / Edge Functions).
SUPABASE_SERVICE_ROLE_KEY="ey..."

# -----------------------------------------------------------------------------
# WAHA — modo SaaS (1 instância para todas as orgs)
# -----------------------------------------------------------------------------
# URL pública do seu WAHA (mesmo em dev, use ngrok pra webhook funcionar)
WAHA_BASE_URL="https://waha.seudominio.com"

# 🔌 WAHA Plus exige API Key. O plaintext aqui é usado no header X-Api-Key.
# O servidor WAHA tem o HASH SHA512 hex desse plaintext na env WAHA_API_KEY.
# 🆓 WAHA Core: deixe vazio se você não setou no servidor.
WAHA_API_KEY_PLAINTEXT="seu-plaintext-secreto-aqui"

# -----------------------------------------------------------------------------
# WAHA — modo BYO (cliente roda WAHA próprio)
# Quando habilitado, cada channel_session pode ter waha_base_url e api_key próprios.
# -----------------------------------------------------------------------------
WAHA_BYO_ENABLED="false"

# Chave usada pra encriptar `waha_api_key_encrypted` na tabela channel_sessions.
# Gere com: openssl rand -hex 32
WAHA_BYO_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Storage de mídia (escolha um)
# -----------------------------------------------------------------------------

# Opção A — Supabase Storage (default recomendado)
SUPABASE_MEDIA_BUCKET="whatsapp-media"

# Opção B — S3 direto (se preferir AWS / Cloudflare R2 / Wasabi)
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="meucrm-whatsapp-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# Observabilidade (opcional mas recomendado)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Rate limiting (opcional — usa Upstash Redis ou similar)
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_URL=""
# UPSTASH_REDIS_TOKEN=""
